<section class="dnd5e2 bg3-tt-card">
    <section class="bg3-tt-header">
        {{#if school}}
        <div class="bg3-tt-school">
            {{#with (lookup @root.config.spellSchools school) as |schoolConfig|}}
            <dnd5e-icon src="{{ schoolConfig.icon }}"></dnd5e-icon>
            {{/with}}
        </div>
        {{/if}}
        <div class="bg3-tt-top">
            <img class="bg3-tt-portrait" src="{{ img }}" alt="{{ name }}">
            <div class="bg3-tt-name">
                <span class="bg3-tt-title">{{ name }}</span>
                <span class="bg3-tt-subtitle">{{{ subtitle }}}</span>
            </div>
        </div>
        <div class="bg3-tt-meta">
            <div class="bg3-tt-price">
                {{#if price}}
                <i class="currency {{ price.denomination }}"></i>
                <span>{{ dnd5e-numberFormat price.value }}</span>
                {{/if}}
            </div>
            <div class="bg3-tt-charges">
                {{#if uses.max}}
                <span>{{ uses.value }}</span>
                <span>&sol;</span>
                <span>{{ uses.max }}</span>
                <span>{{ localize "DND5E.Charges" }}</span>
                {{/if}}
            </div>
            <div class="bg3-tt-weight">
                {{#if weight}}
                <i class="fas fa-weight-hanging"></i>
                <span>{{ weight.value }}</span>
                {{/if}}
            </div>
        </div>
    </section>
    {{#if isSpell}}
        {{> "bg3-hud-dnd5e.spell-block" }}
    {{/if}}
    {{#if (eq type "weapon")}}
        {{> "bg3-hud-dnd5e.weapon-block" }}
    {{/if}}
    <section class="bg3-tt-description">{{{ description.value }}}</section>
    <ul class="bg3-tt-pills">
        {{#each tags}}
        <li class="bg3-tt-pill"><span>{{ this }}</span></li>
        {{/each}}
        {{#each properties}}
        <li class="bg3-tt-pill"><span>{{ this }}</span></li>
        {{/each}}
    </ul>
    {{#if controlHints}}
    <div class="bg3-tt-hint">
        <img src="systems/dnd5e/icons/svg/mouse-middle.svg" alt="{{ localize "DND5E.Controls.MiddleClick" }}">
        <span>{{ localize "DND5E.Controls.LockHint" }}</span>
    </div>
    {{/if}}
</section>
